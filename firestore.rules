rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =====================================================================
    // Funciones de Ayuda (Helpers)
    // =====================================================================
    function isSignedIn() {
      return request.auth != null;
    }

    // Helper to check membership on a trip document via get()
    // Used for subcollection rules.
    function isTripMember(tripId) {
      let trip = get(/databases/$(database)/documents/trips/$(tripId));
      return isSignedIn() && 
             trip.data != null && 
             'members' in trip.data && 
             trip.data.members is list && 
             request.auth.uid in trip.data.members;
    }

    // Helper to check the caller is a participant of a Travel Twins DM thread
    function isThreadParticipant(threadId) {
      let thread = get(/databases/$(database)/documents/travelTwinsThreads/$(threadId));
      return isSignedIn() &&
             thread.data != null &&
             'participants' in thread.data &&
             thread.data.participants is list &&
             request.auth.uid in thread.data.participants;
    }

    function isNewDataValidExpense(data) {
        return data.description is string &&
               data.amountMinor is int && data.amountMinor > 0 &&
               data.originalCurrency in ['CRC', 'JPY', 'USD'] &&
               data.convertedAmountMinor is int && data.convertedAmountMinor > 0 &&
               data.baseCurrency in ['CRC', 'JPY', 'USD'] &&
               data.exchangeRate is number && data.exchangeRate > 0 &&
               data.exchangeRateScaled is int && data.exchangeRateScaled > 0 &&
               data.exchangeRateFetchedAt is string &&
               data.category is string && data.date is string &&
               // OJO: es request.auth.token.email — "request.auth.email" no
               // existe en las reglas y hacía fallar TODAS las altas de gastos
               data.createdBy == request.auth.uid;
    }

    function isTripOwner(tripId) {
      let trip = get(/databases/$(database)/documents/trips/$(tripId));
      return isSignedIn() && trip.data != null &&
             trip.data.info is map &&
             trip.data.info.createdBy == request.auth.uid;
    }

    function isValidExpenseSplit(data, tripId) {
      let trip = get(/databases/$(database)/documents/trips/$(tripId));
      return !('split' in data) || data.split == null ||
        (data.split.enabled == true && data.split.method in ['equal','custom','percentage','shares'] &&
         data.split.paidBy in trip.data.members && data.split.participantIds is list &&
         data.split.participantIds.size() > 0 && data.split.participantIds.hasOnly(trip.data.members) &&
         data.split.allocations is list && data.split.allocations.size() == data.split.participantIds.size());
    }

    // =====================================================================
    // Reglas para la colección 'users'
    // =====================================================================
    match /users/{userId} {
      // Solo el propio usuario puede leer o escribir su documento principal
      allow read, write: if isSignedIn() && request.auth.uid == userId;

      match /notifications/{notificationId} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow create, delete: if false;
        allow update: if isSignedIn() && request.auth.uid == userId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read','readAt','hidden','hiddenAt']);
      }
      match /notificationPreferences/{preferenceId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
      match /devices/{deviceId} {
        allow read, create, update, delete: if isSignedIn() && request.auth.uid == userId;
      }
      match /packing/{documentId} { allow read, write: if isSignedIn() && request.auth.uid == userId; }
      match /data/{documentId} { allow read, write: if isSignedIn() && request.auth.uid == userId; }
      match /gamification/{documentId} { allow read, write: if isSignedIn() && request.auth.uid == userId; }
      match /savedPosts/{documentId} { allow read, write: if isSignedIn() && request.auth.uid == userId; }
    }

    // =====================================================================
    // Reglas para la colección 'userSessions' (Feedback Tracker)
    // =====================================================================
    match /userSessions/{sessionId} {
      // SessionId format: userId_timestamp
      // Extraer userId del sessionId (parte antes del primer '_')
      // Permitir si el usuario autenticado coincide con el userId del sessionId
      allow read, write: if isSignedIn() &&
                            request.auth.uid == sessionId.split('_')[0];
    }

    // =====================================================================
    // Reglas para la colección 'trips'
    // =====================================================================
    match /trips/{tripId} {
      // LECTURA DE DOCUMENTO ESPECÍFICO: Solo miembros del viaje
      allow get: if isSignedIn() &&
                    'members' in resource.data &&
                    resource.data.members is list &&
                    request.auth.uid in resource.data.members;

      // QUERIES/LISTADO: Solo el propio usuario puede listar sus viajes
      allow list: if isSignedIn() &&
                    'members' in resource.data &&
                    resource.data.members is list &&
                    request.auth.uid in resource.data.members;

      // CREACIÓN: Cualquier usuario autenticado puede crear un nuevo viaje.
      allow create: if isSignedIn() &&
                       request.resource.data.info.createdBy == request.auth.uid &&
                       request.auth.uid in request.resource.data.members;

      // ACTUALIZACIÓN: Miembros pueden actualizar (itinerary, etc) pero NO pueden cambiar info crítica
      // Uses resource.data, not get().
      allow update: if isSignedIn() &&
                       'members' in resource.data &&
                       resource.data.members is list &&
                       request.auth.uid in resource.data.members &&
                       request.resource.data.info.createdBy == resource.data.info.createdBy &&
                       request.resource.data.members is list &&
                       request.resource.data.info.createdBy in request.resource.data.members &&
                       (request.resource.data.diff(resource.data).affectedKeys()
                          .hasAny(['members', 'memberEmails']) == false ||
                        request.auth.uid == resource.data.info.createdBy);

      // BORRADO: Solo el dueño del viaje puede eliminarlo.
      // Uses resource.data, not get().
      allow delete: if isSignedIn() && 
                       'info' in resource.data && 
                       resource.data.info is map && 
                       'createdBy' in resource.data.info && 
                       request.auth.uid == resource.data.info.createdBy;

      // --- Sub-colección de Gastos ---
      match /expenses/{expenseId} {
        allow read: if isTripMember(tripId);
        allow create: if isTripMember(tripId) && (
          (isNewDataValidExpense(request.resource.data) && isValidExpenseSplit(request.resource.data, tripId)) ||
          (request.resource.data.desc is string && request.resource.data.amount is number &&
           request.resource.data.amount > 0 && request.resource.data.category is string &&
           request.resource.data.timestamp is number &&
           request.resource.data.addedBy == request.auth.token.email)
        );
        allow update: if isTripMember(tripId) &&
          (resource.data.createdBy == request.auth.uid || isTripOwner(tripId)) &&
          request.resource.data.createdBy == resource.data.createdBy &&
          isNewDataValidExpense(request.resource.data) && isValidExpenseSplit(request.resource.data, tripId);
        allow delete: if isTripMember(tripId) && (resource.data.createdBy == request.auth.uid ||
          get(/databases/$(database)/documents/trips/$(tripId)).data.info.createdBy == request.auth.uid);
      }

      match /budget/{budgetId} {
        allow read: if isTripMember(tripId);
        allow create, update: if isTripMember(tripId) &&
          request.resource.data.amountMinor is int && request.resource.data.amountMinor > 0 &&
          request.resource.data.currency in ['CRC', 'JPY', 'USD'] && request.resource.data.minorUnit is int &&
          request.resource.data.updatedBy == request.auth.uid;
        allow delete: if isTripMember(tripId) &&
          get(/databases/$(database)/documents/trips/$(tripId)).data.info.createdBy == request.auth.uid;
      }

      match /images/{imageId} {
        allow read: if isTripMember(tripId);
        allow create: if isTripMember(tripId) && request.resource.data.userId == request.auth.uid &&
          request.resource.data.tripId == tripId && request.resource.data.storagePath is string &&
          request.resource.data.url is string && request.resource.data.type.matches('image/.*') &&
          request.resource.data.size is int && request.resource.data.size <= 5 * 1024 * 1024;
        allow update: if false;
        allow delete: if isTripMember(tripId) && (resource.data.userId == request.auth.uid ||
          get(/databases/$(database)/documents/trips/$(tripId)).data.info.createdBy == request.auth.uid);
      }

      match /tasks/{taskId} {
        allow read: if isTripMember(tripId);
        allow create: if isTripMember(tripId) && request.resource.data.createdBy == request.auth.uid &&
          request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 140 &&
          request.resource.data.category in ['Vuelos','Hospedaje','Documentos','Reservaciones','Pagos','Transporte','Actividades','Otros'] &&
          request.resource.data.priority in ['Baja','Media','Alta'] && request.resource.data.completed == false;
        allow update: if isTripMember(tripId) && request.resource.data.createdBy == resource.data.createdBy &&
          request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 140 &&
          request.resource.data.category in ['Vuelos','Hospedaje','Documentos','Reservaciones','Pagos','Transporte','Actividades','Otros'] &&
          request.resource.data.priority in ['Baja','Media','Alta'];
        allow delete: if isTripMember(tripId) && (resource.data.createdBy == request.auth.uid ||
          get(/databases/$(database)/documents/trips/$(tripId)).data.info.createdBy == request.auth.uid);
      }

      match /packingItems/{itemId} {
        allow read: if isTripMember(tripId);
        allow create: if isTripMember(tripId) && request.resource.data.createdBy == request.auth.uid &&
          request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 120 &&
          request.resource.data.category in ['Ropa','Higiene','Tecnología','Documentos','Medicamentos','Accesorios','Otros'] &&
          request.resource.data.quantity is int && request.resource.data.quantity >= 1 && request.resource.data.quantity <= 99 &&
          request.resource.data.packed is bool;
        allow update: if isTripMember(tripId) && request.resource.data.createdBy == resource.data.createdBy &&
          request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 120 &&
          request.resource.data.category in ['Ropa','Higiene','Tecnología','Documentos','Medicamentos','Accesorios','Otros'] &&
          request.resource.data.quantity is int && request.resource.data.quantity >= 1 && request.resource.data.quantity <= 99;
        allow delete: if isTripMember(tripId) && (resource.data.createdBy == request.auth.uid ||
          get(/databases/$(database)/documents/trips/$(tripId)).data.info.createdBy == request.auth.uid);
      }

      match /reservations/{reservationId} {
        allow read: if isTripMember(tripId);
        allow create: if isTripMember(tripId) && request.resource.data.createdBy == request.auth.uid &&
          request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 160 &&
          request.resource.data.type in ['Vuelo','Hospedaje','Transporte','Restaurante','Actividad','Seguro','Entrada','Otro'] &&
          request.resource.data.status in ['Pendiente','Confirmada','Cancelada','Completada'] &&
          request.resource.data.startAt is string && request.resource.data.documentCount == 0;
        allow update: if isTripMember(tripId) && request.resource.data.createdBy == resource.data.createdBy &&
          request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 160 &&
          request.resource.data.type in ['Vuelo','Hospedaje','Transporte','Restaurante','Actividad','Seguro','Entrada','Otro'] &&
          request.resource.data.status in ['Pendiente','Confirmada','Cancelada','Completada'] &&
          request.resource.data.documentCount is int && request.resource.data.documentCount >= 0;
        allow delete: if isTripMember(tripId) && resource.data.documentCount == 0;
      }

      match /documents/{documentId} {
        allow read: if isTripMember(tripId) && (resource.data.sensitive == false ||
          resource.data.uploadedBy == request.auth.uid ||
          get(/databases/$(database)/documents/trips/$(tripId)).data.info.createdBy == request.auth.uid);
        allow create: if isTripMember(tripId) && request.resource.data.uploadedBy == request.auth.uid &&
          request.resource.data.visibleName is string && request.resource.data.visibleName.size() > 0 && request.resource.data.visibleName.size() <= 160 &&
          request.resource.data.storagePath is string && !('url' in request.resource.data) &&
          request.resource.data.mimeType in ['application/pdf','image/jpeg','image/png','image/webp'] &&
          request.resource.data.size is int && request.resource.data.size > 0 && request.resource.data.size <= 10 * 1024 * 1024 &&
          request.resource.data.sensitive is bool;
        allow update: if isTripMember(tripId) && resource.data.uploadedBy == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deletionState','deletionRequestedAt']);
        allow delete: if isTripMember(tripId) && (resource.data.uploadedBy == request.auth.uid ||
          get(/databases/$(database)/documents/trips/$(tripId)).data.info.createdBy == request.auth.uid);
      }

      match /documentAudit/{auditId} {
        allow read: if isTripMember(tripId) && get(/databases/$(database)/documents/trips/$(tripId)).data.info.createdBy == request.auth.uid;
        allow create: if isTripMember(tripId) && request.resource.data.actorId == request.auth.uid;
        allow update, delete: if false;
      }

      match /settlements/{settlementId} {
        allow read: if isTripMember(tripId);
        allow create: if isTripMember(tripId) && request.resource.data.createdBy == request.auth.uid &&
          request.resource.data.payerId == request.auth.uid &&
          request.resource.data.payerId in get(/databases/$(database)/documents/trips/$(tripId)).data.members &&
          request.resource.data.receiverId in get(/databases/$(database)/documents/trips/$(tripId)).data.members &&
          request.resource.data.payerId != request.resource.data.receiverId &&
          request.resource.data.amountMinor is int && request.resource.data.amountMinor > 0 &&
          request.resource.data.baseAmountMinor is int && request.resource.data.baseAmountMinor > 0 &&
          request.resource.data.currency in ['CRC','JPY','USD'] && request.resource.data.status == 'pending' && request.resource.data.applied == false;
        allow update: if isTripMember(tripId) && resource.data.status == 'pending' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','applied','confirmedBy','updatedAt']) &&
          ((request.resource.data.status == 'confirmed' && request.resource.data.applied == true &&
            request.resource.data.confirmedBy == request.auth.uid &&
            request.auth.uid == resource.data.receiverId) ||
           (request.resource.data.status == 'voided' && request.resource.data.applied == false &&
            (request.auth.uid == resource.data.createdBy || request.auth.uid == get(/databases/$(database)/documents/trips/$(tripId)).data.info.createdBy)));
        allow delete: if false;
      }

      match /reminders/{reminderId} {
        allow read: if isTripMember(tripId) && resource.data.targetUserId == request.auth.uid;
        allow create: if isTripMember(tripId) && request.resource.data.createdBy == request.auth.uid &&
          request.resource.data.targetUserId == request.auth.uid && request.resource.data.type == 'manual' &&
          request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 100 &&
          request.resource.data.message is string && request.resource.data.message.size() <= 240 &&
          request.resource.data.scheduledAt is string && request.resource.data.timeZone is string && request.resource.data.active == true;
        allow update: if isTripMember(tripId) && resource.data.createdBy == request.auth.uid &&
          request.resource.data.createdBy == resource.data.createdBy &&
          request.resource.data.targetUserId == resource.data.targetUserId &&
          request.resource.data.type == resource.data.type &&
          request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 100 &&
          request.resource.data.message is string && request.resource.data.message.size() <= 240 &&
          request.resource.data.scheduledAt is string && request.resource.data.timeZone is string && request.resource.data.active is bool;
        allow delete: if isTripMember(tripId) && resource.data.createdBy == request.auth.uid;
      }

      // --- Sub-colección de Datos (Itinerario, Notas, Packing) ---
      match /data/{docId} {
        allow read: if isTripMember(tripId);
        allow write: if isTripMember(tripId);
      }

      // --- Sub-colección de Actividades (Checklist) ---
      match /activities/{docId} {
        allow read: if isTripMember(tripId);
        allow write: if isTripMember(tripId);
      }

      // --- Sub-colección de Módulos (Flights, Hotels, etc.) ---
      match /modules/{moduleId} {
        allow read: if isTripMember(tripId);
        allow write: if isTripMember(tripId);
      }

      // --- Sub-colección de Itinerario ---
      match /itinerary/{docId} {
        allow read: if isTripMember(tripId);
        allow write: if isTripMember(tripId);
      }

      // --- Sub-colección de Chat ---
      match /chat/{messageId} {
        allow read: if isTripMember(tripId);
        allow create: if isTripMember(tripId) &&
                         request.resource.data.userId == request.auth.uid;

        // Cualquier miembro puede añadir reacciones, pero ningún otro campo.
        // El autor también puede editar su propio mensaje. Se aceptan los tres
        // nombres históricos para no romper mensajes ya guardados.
        allow update: if isTripMember(tripId) && (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions']) ||
          resource.data.userId == request.auth.uid ||
          resource.data.uid == request.auth.uid ||
          resource.data.senderId == request.auth.uid
        );
        allow delete: if isTripMember(tripId) && (
          resource.data.userId == request.auth.uid ||
          resource.data.uid == request.auth.uid ||
          resource.data.senderId == request.auth.uid
        );
      }

      // --- Sub-colección de Timeline ---
      match /timeline/{activityId} {
        allow read: if isTripMember(tripId);
        allow write: if isTripMember(tripId);
      }

      // --- Sub-colección de Journal ---
      match /journal/{entryId} {
        allow read: if isTripMember(tripId);
        allow write: if isTripMember(tripId);
      }

      // --- Sub-colección de Photos ---
      match /photos/{photoId} {
        allow read: if isTripMember(tripId);
        allow write: if isTripMember(tripId);
      }

      // --- Sub-colección de Polls ---
      match /polls/{pollId} {
        allow read: if isTripMember(tripId);
        allow write: if isTripMember(tripId);
      }

      // --- Sub-colección de Achievements (objeto Achievement, ver
      // OBJECT_BIBLE.md / js/features/achievements/achievements.js) ---
      // Cualquier miembro del viaje puede leer los recuerdos de
      // cualquiera (para ver el perfil de un compañero de viaje), pero
      // cada quien solo puede escribir su propio documento.
      // NOTA: esta regla nunca existió — ni para este sistema ni para
      // el anterior (social-features.js usaba la misma ruta). Antes de
      // esto, toda escritura/lectura aquí fallaba en silencio con
      // "Missing or insufficient permissions". Ver DEPRECATION_LOG.md.
      match /achievements/{userId} {
        allow read: if isTripMember(tripId);
        allow write: if isTripMember(tripId) && request.auth.uid == userId;
      }
    }

    // =====================================================================
    // Reglas para 'posts' - feed social (Japitin Social). Cualquier usuario
    // autenticado puede leer y publicar; solo el autor puede editar/borrar
    // el post, pero cualquiera puede togglear 'likes' o incrementar
    // 'commentCount' (esos son los únicos campos que un no-autor puede tocar).
    // =====================================================================
    match /posts/{postId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      allow update: if isSignedIn() && (
        resource.data.authorId == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'commentCount'])
      );
      allow delete: if isSignedIn() && resource.data.authorId == request.auth.uid;

      match /comments/{commentId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
        allow delete: if isSignedIn() && resource.data.authorId == request.auth.uid;
        allow update: if false;
      }
    }

    // =====================================================================
    // Reglas para 'travelTwinsPool' - resumen de viajes que optaron por ser
    // visibles para el matching de Travel Twins (opt-in, no todos los viajes)
    // Doc ID = tripId. Solo contiene datos ya pensados para ser públicos
    // (ciudades, fechas, presupuesto, intereses) - nunca el itinerario real.
    // =====================================================================
    match /travelTwinsPool/{tripId} {
      // Cualquier usuario autenticado puede ver el pool para buscar matches
      allow read: if isSignedIn();

      // Solo un miembro del viaje puede publicar/actualizar/retirar su propio resumen
      allow create, update: if isTripMember(tripId) &&
                                request.resource.data.ownerId == request.auth.uid;
      allow delete: if isTripMember(tripId);
    }

    // =====================================================================
    // Reglas para 'travelTwinsThreads' - mensajes directos entre dos usuarios
    // que se encontraron vía Travel Twins. Thread ID = "uidA_uidB" (ordenados).
    // =====================================================================
    match /travelTwinsThreads/{threadId} {
      allow read: if isSignedIn() &&
                     'participants' in resource.data &&
                     request.auth.uid in resource.data.participants;
      allow create: if isSignedIn() &&
                       request.auth.uid in request.resource.data.participants &&
                       request.resource.data.participants.size() == 2;
      allow update: if isSignedIn() &&
                       request.auth.uid in resource.data.participants;

      match /messages/{messageId} {
        allow read: if isThreadParticipant(threadId);
        allow create: if isThreadParticipant(threadId) &&
                          request.resource.data.senderId == request.auth.uid;
        allow update, delete: if false;
      }
    }
  }
}
